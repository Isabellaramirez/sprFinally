<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.example.appsrp.activity.HomePrestador">

    <!-- Foto de perfilandroid:src="@drawable/ic_user_placeholder" -->
    <ImageView
            android:id="@+id/fotoPerfil"
            android:layout_width="100dp"
            android:layout_height="100dp"

            android:contentDescription="Foto de perfil"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"
            app:layout_constraintBottom_toTopOf="@+id/nombreUsuario"/>

    <!-- Nombre del usuario -->
    <TextView
            android:id="@+id/nombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Prestador"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/fotoPerfil"
            app:layout_constraintStart_toStartOf="@id/fotoPerfil"
            android:layout_marginTop="8dp"/>

    <!-- Botón Editar Perfil -->
    <Button
            android:id="@+id/btnEditarPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar perfil"
            app:layout_constraintTop_toBottomOf="@id/nombreUsuario"
            app:layout_constraintStart_toStartOf="@id/nombreUsuario"
            android:layout_marginTop="16dp"/>

    <!-- Título de Servicios -->
    <TextView
            android:id="@+id/tituloServicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servicios Ofrecidos"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnEditarPerfil"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"/>

    <!-- Lista de servicios (puede cambiarse a RecyclerView) -->
    <ListView
            android:id="@+id/listaServicios"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tituloServicios"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
