<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.PrestadorActivity">
<!--app:layout_constraintTop_toBottomOf-->
<!--significa que cada campo esta debajo del anterior-->
<!--constraintStart y constraintEnd-->
<!--significa que estan centrados horizontalmente-->
<!--android:layout_marginTop-->
<!--se usa para separar elementos-->
    <EditText

            android:id="@+id/etCedula"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Cedula"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            />

    <EditText

            android:id="@+id/etNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nombres"
            app:layout_constraintTop_toBottomOf="@id/etCedula"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"/>

    <EditText
            android:id="@+id/Apellido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Apellidos"
            app:layout_constraintTop_toBottomOf="@id/etNombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"/>

    <EditText
            android:id="@+id/etCiudad"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Ciudad de vivienda"
            app:layout_constraintTop_toBottomOf="@id/Apellido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"/>

    <EditText
            android:id="@+id/etCelular"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Celular"
            app:layout_constraintTop_toBottomOf="@id/etCiudad"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"/>

    <EditText
            android:id="@+id/etCorreo"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Correo"
            app:layout_constraintTop_toBottomOf="@id/etCelular"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"/>

    <EditText
            android:id="@+id/etFechaNacimiento"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Fecha Nacimiento (YYYY-MM-DD"
            app:layout_constraintTop_toBottomOf="@id/etCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
    />
    <EditText
            android:id="@+id/etCategoria"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Categoria"
            app:layout_constraintTop_toBottomOf="@id/etFechaNacimiento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            />
    <EditText
            android:id="@+id/Servicio"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:hint="Servicio"
            app:layout_constraintTop_toBottomOf="@id/etCategoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
    />

    <Button
            android:id="@+id/btnCrearPerfilPrestador"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="Crear Perfil"
            app:layout_constraintTop_toBottomOf="@id/Servicio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="16dp"
    />
</androidx.constraintlayout.widget.ConstraintLayout>

